{
  "name": "richual-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter richual dev",
    "build": "pnpm --filter richual build",
    "deploy": "pnpm --filter richual run deploy",
    "test": "pnpm -r --stream test",
    "typecheck": "pnpm -r --stream typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
